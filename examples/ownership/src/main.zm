fn show(text: &string) {
    println(text)
}

fn update(text: &mut string) {
    text = "借用结束后，所有者仍然可用"
}

fn consume(text: string) {
    println(text)
}

fn main() {
    let mut message = "你好，原生 Zamak"
    show(&message)
    update(&mut message)
    show(&message)
    let moved = message
    consume(moved)
}
