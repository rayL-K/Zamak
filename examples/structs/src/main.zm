use model

struct Team {
    leader: model.Person
}

fn team() -> Team {
    Team { leader: model.create("team leader") }
}

fn main() {
    let mut person: model.Person = model.birthday(model.create("Zamak"))
    person.name = "updated"
    person.age = person.age + 1
    person.active = !person.active
    println(person.name)
    let moved = person
    println(moved.age + 1)
    println(moved.active)
    person = model.Person {
        name: "new owner"
        age: 7
        active: false
    }
    println(person.age)
    let mut group = team()
    group.leader = model.create("replacement")
    group.leader.age = group.leader.age + 1
    println(group.leader.name)
    let transferred = group
    println(transferred.leader.age)
    team()
}
